{
  "name": "gateway-service",
  "version": "1.0.3",
  "description": "Omnixys Gateway Service",
  "author": {
    "name": "Caleb Gyamfi",
    "email": "caleb@omnixys.com",
    "url": "https://omnixys.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omnixys/gateway-service.git"
  },
  "bugs": {
    "url": "https://github.com/omnixys/gateway-service/issues"
  },
  "homepage": "https://omnixys.com",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=11.1.2"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "build": "pnpm run clean && nest build",
    "format": "prettier --cache --write \"src/**/*.{ts,js,json,prisma,md,yaml}\"",
    "format:test": "prettier --cache --write \"src/**/*.{ts,js,json,prisma,md,yaml}\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --cache --check \"src/**/*.{ts,js,json,prisma,md,yaml,yml}\" \"__test__/**/*.ts\"",
    "start": "pnpm nest start",
    "dev": "pnpm run clean && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm run build && node --test __tests__/unit/*.test.mjs",
    "test:integration": "pnpm run build && node --test __tests__/integration/*.test.mjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e:debug": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --detectOpenHandles --config ./__tests__/jest-e2e.json",
    "test:e2e2": "jest --config ./__tests__/jest-e2e.json",
    "test:e2e": "pnpm run build && node --test __tests__/e2e/gateway/*.test.mjs",
    "typedoc": "typedoc",
    "depcheck": "depcheck",
    "test:login": "pnpm test -- __tests__/e2e/gateway/gateway.login.e2e-spec.ts",
    "test:signup": "pnpm test -- __tests__/e2e/gateway/gateway.signup.e2e-spec.ts",
    "test:gateway": "pnpm test -- __tests__/e2e/gateway/gateway.gateway.e2e-spec.ts",
    "test:admin": "pnpm test -- __tests__/e2e/gateway/gateway.admin.e2e-spec.ts",
    "prisma:gen": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "release": "semantic-release",
    "deps:audit": "tsx scripts/dependency-audit.ts"
  },
  "dependencies": {
    "@apollo/gateway": "^2.13.3",
    "@apollo/server": "^5.5.0",
    "@apollo/subgraph": "^2.13.3",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs/apollo": "^13.2.4",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/graphql": "^13.2.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/platform-fastify": "^11.1.17",
    "@nestjs/terminus": "^11.1.1",
    "@omnixys/cache": "file:../../packages/ts/cache",
    "@omnixys/context": "file:../../packages/ts/context",
    "@omnixys/graphql": "file:../../packages/ts/graphql",
    "@omnixys/kafka": "file:../../packages/ts/kafka",
    "@omnixys/logger": "file:../../packages/ts/logger",
    "@omnixys/observability": "file:../../packages/ts/observability",
    "@omnixys/security": "file:../../packages/ts/security",
    "@omnixys/shared": "file:../../packages/ts/shared",
    "@prisma/client": "^6.19.2",
    "@valkey/client": "^1.0.0",
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "class-validator": "^0.14.4",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.5",
    "graphql-subscriptions": "^3.0.0",
    "jwks-rsa": "^3.2.2",
    "kafkajs": "^2.2.4",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.15.21",
    "@tsconfig/node23": "^23.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "@types/passport-jwt": "^4.0.1",
    "depcheck": "latest",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-imports": "^1.8.11",
    "semantic-release": "^25.0.3",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.8.5"
    }
  }
}
