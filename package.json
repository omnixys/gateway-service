{
  "name": "gateway-service",
  "version": "3.1.1",
  "description": "Omnixys Gateway Service",
  "author": {
    "name": "Caleb Gyamfi",
    "email": "caleb.gyamfi@omnixys.com",
    "url": "https://omnixys.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omnixys/gateway-service.git"
  },
  "bugs": {
    "url": "https://github.com/omnixys/gateway-service/issues"
  },
  "homepage": "https://omnixys.com",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": false,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "build": "pnpm run clean && nest build",
    "format": "prettier --cache --write \"src/**/*.{ts,js,json,prisma,md,yaml}\"",
    "format:test": "prettier --cache --write \"src/**/*.{ts,js,json,prisma,md,yaml}\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --cache --check \"src/**/*.{ts,js,json,prisma,md,yaml,yml}\" \"__test__/**/*.ts\"",
    "start": "pnpm nest start",
    "dev": "pnpm run clean && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm run build && node --test __tests__/unit/*.test.mjs",
    "test:integration": "pnpm run build && node --test __tests__/integration/*.test.mjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e:debug": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --detectOpenHandles --config ./__tests__/jest-e2e.json",
    "test:e2e2": "jest --config ./__tests__/jest-e2e.json",
    "test:e2e": "pnpm run build && node --test __tests__/e2e/gateway/*.test.mjs",
    "typedoc": "typedoc",
    "depcheck": "depcheck",
    "test:login": "pnpm test -- __tests__/e2e/gateway/gateway.login.e2e-spec.ts",
    "test:signup": "pnpm test -- __tests__/e2e/gateway/gateway.signup.e2e-spec.ts",
    "test:gateway": "pnpm test -- __tests__/e2e/gateway/gateway.gateway.e2e-spec.ts",
    "test:admin": "pnpm test -- __tests__/e2e/gateway/gateway.admin.e2e-spec.ts",
    "prisma:gen": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "release": "semantic-release",
    "deps:audit": "tsx scripts/dependency-audit.ts"
  },
  "dependencies": {
    "@apollo/gateway": "^2.14.3",
    "@apollo/server": "^5.5.1",
    "@apollo/subgraph": "^2.14.3",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/terminus": "^11.1.1",
    "@omnixys/cache": "^3.0.1",
    "@omnixys/context": "^3.0.0",
    "@omnixys/contracts": "^3.1.0",
    "@omnixys/graphql": "^3.0.1",
    "@omnixys/kafka": "^3.1.1",
    "@omnixys/logger": "^3.1.0",
    "@omnixys/observability": "^3.1.0",
    "@omnixys/security": "^3.0.2",
    "@valkey/client": "^1.0.0",
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "fastify": "5.8.5",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tsconfig/node23": "^23.0.4",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "depcheck": "latest",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-imports": "^1.8.11",
    "prisma": "^7.9.0",
    "semantic-release": "^25.0.8",
    "ts-morph": "^27.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
